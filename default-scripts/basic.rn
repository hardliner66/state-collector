// Collect system state from the local device.
// Usage:
//   state-collector                             # use built-in script
//   state-collector basic.rn                    # explicit script path
//   state-collector --output /tmp/snapshot.sc   # custom output path

use process::{Command, Stdio};

pub async fn collect() {
    sc::log(`starting collection at ${sc::timestamp()}`);

    collect_resources().await;
    collect_sysinfo().await;
    collect_hardware().await;
    collect_services().await;
    collect_systemd_status().await;
    collect_logs().await;
    collect_kernel_logs().await;
    collect_processes().await;
    collect_network().await;
    collect_wifi().await;
    collect_ports().await;
    collect_filesystems().await;
    collect_summary().await;

    sc::log("done.");
}

async fn run_raw(cmd, args) {
    let command = Command::new(cmd);
    command.args(args);
    command.stdout(Stdio::piped());
    command.stderr(Stdio::piped());

    match command.spawn() {
        Ok(child) => match child.wait_with_output().await {
            Ok(output) => match String::from_utf8(output.stdout) {
                Ok(stdout) => {
                    if stdout.trim().is_empty() {
                        match String::from_utf8(output.stderr) {
                            Ok(stderr) => stderr,
                            Err(error) => `[error: ${error}]`,
                        }
                    } else {
                        stdout
                    }
                }
                Err(error) => `[error: ${error}]`,
            },
            Err(error) => `[error: ${error}]`,
        },
        Err(error) => `[error: ${error}]`,
    }
}

async fn collect_resources() {
    sc::log("  resources...");
    sc::write("resources.txt", sc::resources_text()?)?;
}

async fn collect_sysinfo() {
    sc::log("  sysinfo...");
    sc::write("sysinfo.txt", sc::sysinfo_text()?)?;
}

async fn collect_hardware() {
    sc::log("  hardware...");
    sc::write("hardware.txt", sc::hardware_text()?)?;
}

async fn collect_services() {
    sc::log("  services...");
    sc::write("services.txt", sc::services_text()?)?;
}

async fn collect_systemd_status() {
    sc::log("  systemd status...");
    sc::write("systemd_status.txt", sc::systemd_status_text()?)?;
}

async fn collect_logs() {
    sc::log("  logs...");
    let units = sc::log_units()?;
    sc::log(`  collecting ${units.len()} units`);

    for unit in units {
        let filename = unit.replace("/", "_").replace("*", "");
        let output = run_raw("journalctl", ["-n", "500", "--no-pager", "-u", unit]).await;
        sc::write(`logs/${filename}.log`, output)?;
    }
}

async fn collect_kernel_logs() {
    sc::log("  kernel logs...");
    let buf = run_raw("dmesg", ["-T", "--level=err,warn"]).await
        + run_raw("journalctl", ["-k", "-n", "500", "--no-pager"]).await
        + run_raw("journalctl", ["-b", "-n", "1000", "--no-pager"]).await
        + run_raw("journalctl", ["-p", "warning..alert", "-n", "1000", "--no-pager"]).await;
    sc::write("kernel_logs.txt", buf)?;
}

async fn collect_processes() {
    sc::log("  processes...");
    sc::write("processes.txt", sc::processes_text()?)?;
}

async fn collect_network() {
    sc::log("  network...");
    sc::write("network.txt", sc::network_text()?)?;
}

async fn collect_wifi() {
    sc::log("  wifi...");
    sc::write("wifi.txt", sc::wifi_text()?)?;
}

async fn collect_ports() {
    sc::log("  ports...");
    sc::write("ports.txt", sc::ports_text()?)?;
}

async fn collect_filesystems() {
    sc::log("  filesystems...");
    sc::write("filesystems.txt", sc::filesystems_text()?)?;
}

async fn collect_summary() {
    sc::log("  summary...");
    sc::write("summary.txt", sc::summary_text()?)?;
}
