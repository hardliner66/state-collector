// Collect system state and store it in a postcard-encoded binary file.
// Usage:
//   state-collector binary

pub async fn collect() {
    sc::log(`starting binary collection at ${sc::timestamp()}`);
    let snapshot = sc::snapshot()?;
    sc::write_bytes("state.bin", sc::snapshot_to_bytes(snapshot)?)?;
    sc::log("binary collection complete.");
}
