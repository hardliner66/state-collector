// Collect system state from the local device.
// Usage:
//   state-collector                                  # use built-in script
//   state-collector examples/basic.rn                # explicit script path
//   state-collector --output /tmp/snapshot.sc        # custom output path

use process::{Command, Stdio};

pub async fn collect() {
    sc::log(`starting collection at ${sc::timestamp()}`);

    collect_resources().await;
    collect_sysinfo().await;
    collect_hardware().await;
    collect_services().await;
    collect_systemd_status().await;
    collect_logs().await;
    collect_kernel_logs().await;
    collect_processes().await;
    collect_network().await;
    collect_wifi().await;
    collect_ports().await;
    collect_filesystems().await;
    collect_summary().await;

    sc::log("done.");
}

// ── Helpers ──────────────────────────────────────────────────────────────────

async fn run_raw(cmd, args) {
    let command = Command::new(cmd);
    command.args(args);
    command.stdout(Stdio::piped());
    command.stderr(Stdio::piped());

    match command.spawn() {
        Ok(child) => match child.wait_with_output().await {
            Ok(output) => match String::from_utf8(output.stdout) {
                Ok(stdout) => {
                    if stdout.trim().is_empty() {
                        match String::from_utf8(output.stderr) {
                            Ok(stderr) => stderr,
                            Err(error) => {
                                `[error: ${error}]`
                            }
                        }
                    } else {
                        stdout
                    }
                }
                Err(error) => {
                    `[error: ${error}]`
                }
            },
            Err(error) => {
                `[error: ${error}]`
            }
        },
        Err(error) => {
            `[error: ${error}]`
        }
    }
}

async fn run(cmd, args) {
    let header = `=== ${cmd}`;
    let i = 0;
    while i < args.len() {
        header += ` ${args[i]}`;
        i += 1;
    }
    header += " ===\n";

    `${header}${run_raw(cmd, args).await}\n`
}

// Return the first whitespace-delimited field of a line.
fn first_field(line) {
    for part in line.split(" ") {
        if !part.is_empty() {
            return part;
        }
    }
    ""
}

// Build the list of units to collect logs for:
async fn log_units() {
    let units = ["NetworkManager.service", "sshd@.service"];

    let output = run_raw("systemctl", [
        "list-units", "--type=service", "--all",
        "--plain", "--no-legend", "--no-pager",
    ]).await;

    for line in output.split("\n") {
        let line = line.trim();
        if line.is_empty() { continue; }
        let unit = first_field(line);

        // Index-based search to avoid consuming `units` with a for loop.
        let found = false;
        let i = 0;
        while i < units.len() {
            if units[i] == unit {
                found = true;
                break;
            }
            i += 1;
        }
        if !found {
            units.push(unit);
        }
    }

    units
}

// ── Collectors ───────────────────────────────────────────────────────────────

async fn collect_resources() {
    sc::log("  resources...");
    let buf = run("uptime", []).await
        + run("free", ["-h"]).await
        + run("df", ["-h", "/"]).await;
    sc::write("resources.txt", buf)?;
}

async fn collect_sysinfo() {
    sc::log("  sysinfo...");
    let buf = run("uname", ["-a"]).await
        + run("hostnamectl", []).await
        + run("cat", ["/etc/os-release"]).await
        + run("uptime", []).await
        + run("timedatectl", []).await
        + run("locale", []).await;
    sc::write("sysinfo.txt", buf)?;
}

async fn collect_hardware() {
    sc::log("  hardware...");
    let buf = run("free", ["-h"]).await
        + run("lsblk", ["-f"]).await
        + run("blkid", []).await
        + run("lspci", []).await
        + run("lsusb", []).await;
    sc::write("hardware.txt", buf)?;
}

async fn collect_services() {
    sc::log("  services...");
    let buf = run("systemctl", [
        "list-units", "--type=service", "--all", "--no-pager",
    ]).await;
    sc::write("services.txt", buf)?;
}

async fn collect_systemd_status() {
    sc::log("  systemd status...");
    let buf = run("systemctl", ["--failed"]).await
        + run("systemctl", ["list-units", "--state=failed"]).await
        + run("systemctl", ["list-timers", "--all"]).await
        + run("systemctl", ["list-jobs"]).await;
    sc::write("systemd_status.txt", buf)?;
}

async fn collect_logs() {
    sc::log("  logs...");
    let units = log_units().await;
    sc::log(`  collecting ${units.len()} units`);

    for unit in units {
        // Compute filename before `unit` is consumed by the args array in run().
        let filename = unit.replace("/", "_").replace("*", "");
        let output = run("journalctl", ["-n", "500", "--no-pager", "-u", unit]).await;
        sc::write(`logs/${filename}.log`, output)?;
    }
}

async fn collect_kernel_logs() {
    sc::log("  kernel logs...");
    let buf = run("dmesg", ["-T", "--level=err,warn"]).await
        + run("journalctl", ["-k", "-n", "500", "--no-pager"]).await
        + run("journalctl", ["-b", "-n", "1000", "--no-pager"]).await
        + run("journalctl", ["-p", "warning..alert", "-n", "1000", "--no-pager"]).await;
    sc::write("kernel_logs.txt", buf)?;
}

async fn collect_processes() {
    sc::log("  processes...");
    sc::write("processes.txt", run("ps", ["aux"]).await)?;
}

async fn collect_network() {
    sc::log("  network...");
    let buf = run("ip", ["addr"]).await
        + run("ip", ["route"]).await
        + run("ip", ["rule"]).await
        + run("resolvectl", ["status"]).await
        + run("cat", ["/etc/resolv.conf"]).await;
    sc::write("network.txt", buf)?;
}

async fn collect_wifi() {
    sc::log("  wifi...");
    let out = run("nmcli", ["dev", "wifi"]).await;
    if !out.contains("[error:") {
        sc::write("wifi.txt", out)?;
    }
}

async fn collect_ports() {
    sc::log("  ports...");
    let out = run("netstat", ["-an"]).await;
    if !out.contains("[error:") {
        sc::write("ports.txt", out)?;
    }
}

async fn collect_filesystems() {
    sc::log("  filesystems...");
    let buf = run("mount", []).await
        + run("findmnt", []).await
        + run("lsblk", []).await
        + run("df", ["-h"]).await
        + run("df", ["-ih"]).await
        + run("du", ["-sh", "/var/log", "/tmp"]).await
        + run("du", ["-h", "/media/card"]).await;
    sc::write("filesystems.txt", buf)?;
}

async fn collect_summary() {
    sc::log("  summary...");

    let hostname = sc::hostname()?;
    let os_name = sc::os_pretty_name()?;
    let uptime = sc::uptime()?;
    let failed = run_raw("systemctl", ["--failed", "--no-legend", "--no-pager"]).await.trim();
    let ip_brief = run_raw("ip", ["-brief", "addr"]).await;

    let buf = "System State Dump\n";
    buf += `Collected: ${sc::timestamp()}\n\n`;
    buf += `Hostname:  ${hostname}\n`;
    buf += `OS:        ${os_name}\n`;
    buf += `Uptime:    ${uptime}\n`;
    buf += "\nRESOURCES\n---------\n";
    buf += run_raw("uptime", []).await;
    buf += "\n";
    buf += run_raw("free", ["-h"]).await;
    buf += "\n";
    buf += run_raw("df", ["-h", "/"]).await;
    buf += "\nFAILED UNITS\n------------\n";
    if failed.is_empty() {
        buf += "(none)\n";
    } else {
        buf += failed;
        buf += "\n";
    }
    buf += "\nNETWORK\n-------\n";
    buf += ip_brief;
    buf += "\nFILES\n-----\n";
    buf += "  resources.txt       uptime, free, df /\n";
    buf += "  sysinfo.txt         uname, hostnamectl, OS release, uptime, timezone, locale\n";
    buf += "  hardware.txt        free, lsblk, blkid, lspci, lsusb\n";
    buf += "  services.txt        all systemd services\n";
    buf += "  systemd_status.txt  failed units, timers, active jobs\n";
    buf += "  kernel_logs.txt     dmesg (err/warn), journal kernel+boot+warning logs\n";
    buf += "  processes.txt       ps aux\n";
    buf += "  network.txt         ip addr/route/rule, resolvectl, resolv.conf\n";
    buf += "  wifi.txt            nmcli wifi (if available)\n";
    buf += "  ports.txt           netstat -an (if available)\n";
    buf += "  filesystems.txt     mount, findmnt, lsblk, df, du\n";
    buf += "  logs/               per-service journal logs (500 lines each)\n";

    sc::write("summary.txt", buf)?;
}
