// Collect system state and store it as structured JSON.
// Usage:
//   state-collector examples/json.rn

use process::{Command, Stdio};

async fn run_raw(cmd, args) {
    let command = Command::new(cmd);
    command.args(args);
    command.stdout(Stdio::piped());
    command.stderr(Stdio::piped());

    match command.spawn() {
        Ok(child) => match child.wait_with_output().await {
            Ok(output) => match String::from_utf8(output.stdout) {
                Ok(stdout) => {
                    if stdout.trim().is_empty() {
                        match String::from_utf8(output.stderr) {
                            Ok(stderr) => stderr,
                            Err(error) => `[error: ${error}]`,
                        }
                    } else {
                        stdout
                    }
                }
                Err(error) => `[error: ${error}]`,
            },
            Err(error) => `[error: ${error}]`,
        },
        Err(error) => `[error: ${error}]`,
    }
}

async fn command_entry(cmd, args) {
    #{
        "command": cmd,
        "args": args,
        "output": run_raw(cmd, args).await,
    }
}

fn first_field(line) {
    for part in line.split(" ") {
        if !part.is_empty() {
            return part;
        }
    }
    ""
}

async fn log_units() {
    let units = ["NetworkManager.service", "sshd@.service"];

    let output = run_raw("systemctl", [
        "list-units", "--type=service", "--all",
        "--plain", "--no-legend", "--no-pager",
    ]).await;

    for line in output.split("\n") {
        let line = line.trim();
        if line.is_empty() { continue; }
        let unit = first_field(line);

        let found = false;
        let i = 0;
        while i < units.len() {
            if units[i] == unit {
                found = true;
                break;
            }
            i += 1;
        }

        if !found {
            units.push(unit);
        }
    }

    units
}

async fn build_payload() {
    let resources = #{
        "uptime": command_entry("uptime", []).await,
        "memory_free_h": command_entry("free", ["-h"]).await,
        "disk_root_df_h": command_entry("df", ["-h", "/"]).await,
    };

    let sysinfo = #{
        "uname": command_entry("uname", ["-a"]).await,
        "hostnamectl": command_entry("hostnamectl", []).await,
        "os_release": command_entry("cat", ["/etc/os-release"]).await,
        "uptime": command_entry("uptime", []).await,
        "timedatectl": command_entry("timedatectl", []).await,
        "locale": command_entry("locale", []).await,
    };

    let hardware = #{
        "memory_free_h": command_entry("free", ["-h"]).await,
        "lsblk_f": command_entry("lsblk", ["-f"]).await,
        "blkid": command_entry("blkid", []).await,
        "lspci": command_entry("lspci", []).await,
        "lsusb": command_entry("lsusb", []).await,
    };

    let services = #{
        "list_units": command_entry("systemctl", ["list-units", "--type=service", "--all", "--no-pager"]).await,
    };

    let systemd_status = #{
        "failed": command_entry("systemctl", ["--failed"]).await,
        "failed_units": command_entry("systemctl", ["list-units", "--state=failed"]).await,
        "timers_all": command_entry("systemctl", ["list-timers", "--all"]).await,
        "jobs": command_entry("systemctl", ["list-jobs"]).await,
    };

    let logs = [];
    let units = log_units().await;
    for unit in units {
        logs.push(#{
            "unit": unit,
            "file_hint": `logs/${unit.replace("/", "_").replace("*", "")}.log`,
            "journal": command_entry("journalctl", ["-n", "500", "--no-pager", "-u", unit]).await,
        });
    }

    let kernel_logs = #{
        "dmesg_warn_err": command_entry("dmesg", ["-T", "--level=err,warn"]).await,
        "journal_kernel": command_entry("journalctl", ["-k", "-n", "500", "--no-pager"]).await,
        "journal_boot": command_entry("journalctl", ["-b", "-n", "1000", "--no-pager"]).await,
        "journal_warn_alert": command_entry("journalctl", ["-p", "warning..alert", "-n", "1000", "--no-pager"]).await,
    };

    let processes = #{
        "ps_aux": command_entry("ps", ["aux"]).await,
    };

    let network = #{
        "ip_addr": command_entry("ip", ["addr"]).await,
        "ip_route": command_entry("ip", ["route"]).await,
        "ip_rule": command_entry("ip", ["rule"]).await,
        "resolvectl_status": command_entry("resolvectl", ["status"]).await,
        "resolv_conf": command_entry("cat", ["/etc/resolv.conf"]).await,
    };

    let wifi_output = run_raw("nmcli", ["dev", "wifi"]).await;
    let wifi = if wifi_output.contains("[error:") {
        #{"available": false, "error": wifi_output}
    } else {
        #{
            "available": true,
            "nmcli_dev_wifi": #{
                "command": "nmcli",
                "args": ["dev", "wifi"],
                "output": wifi_output,
            },
        }
    };

    let ports_output = run_raw("netstat", ["-an"]).await;
    let ports = if ports_output.contains("[error:") {
        #{"available": false, "error": ports_output}
    } else {
        #{
            "available": true,
            "netstat_an": #{
                "command": "netstat",
                "args": ["-an"],
                "output": ports_output,
            },
        }
    };

    let filesystems = #{
        "mount": command_entry("mount", []).await,
        "findmnt": command_entry("findmnt", []).await,
        "lsblk": command_entry("lsblk", []).await,
        "df_h": command_entry("df", ["-h"]).await,
        "df_ih": command_entry("df", ["-ih"]).await,
        "du_log_tmp": command_entry("du", ["-sh", "/var/log", "/tmp"]).await,
        "du_media_card": command_entry("du", ["-h", "/media/card"]).await,
    };

    let summary_hostname = sc::hostname()?;
    let summary_os_pretty_name = sc::os_pretty_name()?;
    let summary_uptime = sc::uptime()?;
    let summary_failed = run_raw("systemctl", ["--failed", "--no-legend", "--no-pager"]).await.trim();
    let summary_ip_brief = run_raw("ip", ["-brief", "addr"]).await;
    let summary_uptime_raw = run_raw("uptime", []).await;
    let summary_free_raw = run_raw("free", ["-h"]).await;
    let summary_df_root_raw = run_raw("df", ["-h", "/"]).await;

    let summary = #{
        "hostname": summary_hostname,
        "os_pretty_name": summary_os_pretty_name,
        "uptime": summary_uptime,
        "failed_units_raw": summary_failed,
        "ip_brief": summary_ip_brief,
        "resources_snapshot": #{
            "uptime": summary_uptime_raw,
            "free_h": summary_free_raw,
            "df_root_h": summary_df_root_raw,
        },
    };

    #{
        "format": "state-collector-json-v2",
        "generated_at": sc::timestamp(),
        "collector_version": sc::version(),
        "outdir": sc::outdir(),
        "sections": #{
            "resources": resources,
            "sysinfo": sysinfo,
            "hardware": hardware,
            "services": services,
            "systemd_status": systemd_status,
            "logs": logs,
            "kernel_logs": kernel_logs,
            "processes": processes,
            "network": network,
            "wifi": wifi,
            "ports": ports,
            "filesystems": filesystems,
            "summary": summary,
        },
    }
}

pub async fn collect() {
    sc::log(`starting JSON collection at ${sc::timestamp()}`);

    sc::log("  collecting structured sections...");
    let payload = build_payload().await;

    let json_text = json::to_string(payload)?;
    sc::write("state.json", json_text)?;

    sc::log("JSON collection complete.");
}
