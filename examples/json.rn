// Collect system state and store everything in one JSON file.
// Usage:
//   state-collector examples/json.rn

use process::{Command, Stdio};

async fn run_raw(cmd, args) {
    let command = Command::new(cmd);
    command.args(args);
    command.stdout(Stdio::piped());
    command.stderr(Stdio::piped());

    match command.spawn() {
        Ok(child) => match child.wait_with_output().await {
            Ok(output) => match String::from_utf8(output.stdout) {
                Ok(stdout) => {
                    if stdout.trim().is_empty() {
                        match String::from_utf8(output.stderr) {
                            Ok(stderr) => stderr,
                            Err(error) => `[error: ${error}]`,
                        }
                    } else {
                        stdout
                    }
                }
                Err(error) => `[error: ${error}]`,
            },
            Err(error) => `[error: ${error}]`,
        },
        Err(error) => `[error: ${error}]`,
    }
}

fn first_field(line) {
    for part in line.split(" ") {
        if !part.is_empty() {
            return part;
        }
    }
    ""
}

async fn log_units() {
    let units = ["NetworkManager.service", "sshd@.service"];

    let output = run_raw("systemctl", [
        "list-units", "--type=service", "--all",
        "--plain", "--no-legend", "--no-pager",
    ]).await;

    for line in output.split("\n") {
        let line = line.trim();
        if line.is_empty() {
            continue;
        }

        let unit = first_field(line);
        let found = false;
        let i = 0;

        while i < units.len() {
            if units[i] == unit {
                found = true;
                break;
            }
            i += 1;
        }

        if !found {
            units.push(unit);
        }
    }

    units
}

async fn push(entries, section, cmd, args) {
    entries.push(#{
        "section": section,
        "command": cmd,
        "args": args,
        "output": run_raw(cmd, args).await,
    });
}

pub async fn collect() {
    sc::log(`starting JSON collection at ${sc::timestamp()}`);

    let entries = [];

    sc::log("  resources...");
    push(entries, "resources", "uptime", []).await;
    push(entries, "resources", "free", ["-h"]).await;
    push(entries, "resources", "df", ["-h", "/"]).await;

    sc::log("  sysinfo...");
    push(entries, "sysinfo", "uname", ["-a"]).await;
    push(entries, "sysinfo", "hostnamectl", []).await;
    push(entries, "sysinfo", "cat", ["/etc/os-release"]).await;
    push(entries, "sysinfo", "uptime", []).await;
    push(entries, "sysinfo", "timedatectl", []).await;
    push(entries, "sysinfo", "locale", []).await;

    sc::log("  hardware...");
    push(entries, "hardware", "free", ["-h"]).await;
    push(entries, "hardware", "lsblk", ["-f"]).await;
    push(entries, "hardware", "blkid", []).await;
    push(entries, "hardware", "lspci", []).await;
    push(entries, "hardware", "lsusb", []).await;

    sc::log("  services...");
    push(entries, "services", "systemctl", [
        "list-units", "--type=service", "--all", "--no-pager",
    ]).await;

    sc::log("  systemd status...");
    push(entries, "systemd_status", "systemctl", ["--failed"]).await;
    push(entries, "systemd_status", "systemctl", ["list-units", "--state=failed"]).await;
    push(entries, "systemd_status", "systemctl", ["list-timers", "--all"]).await;
    push(entries, "systemd_status", "systemctl", ["list-jobs"]).await;

    sc::log("  logs...");
    let units = log_units().await;
    sc::log(`  collecting ${units.len()} units`);
    for unit in units {
        push(entries, `logs/${unit.replace("/", "_").replace("*", "")}`, "journalctl", [
            "-n", "500", "--no-pager", "-u", unit,
        ]).await;
    }

    sc::log("  kernel logs...");
    push(entries, "kernel_logs", "dmesg", ["-T", "--level=err,warn"]).await;
    push(entries, "kernel_logs", "journalctl", ["-k", "-n", "500", "--no-pager"]).await;
    push(entries, "kernel_logs", "journalctl", ["-b", "-n", "1000", "--no-pager"]).await;
    push(entries, "kernel_logs", "journalctl", ["-p", "warning..alert", "-n", "1000", "--no-pager"]).await;

    sc::log("  processes...");
    push(entries, "processes", "ps", ["aux"]).await;

    sc::log("  network...");
    push(entries, "network", "ip", ["addr"]).await;
    push(entries, "network", "ip", ["route"]).await;
    push(entries, "network", "ip", ["rule"]).await;
    push(entries, "network", "resolvectl", ["status"]).await;
    push(entries, "network", "cat", ["/etc/resolv.conf"]).await;

    sc::log("  wifi...");
    let wifi = run_raw("nmcli", ["dev", "wifi"]).await;
    if !wifi.contains("[error:") {
        entries.push(#{
            "section": "wifi",
            "command": "nmcli",
            "args": ["dev", "wifi"],
            "output": wifi,
        });
    }

    sc::log("  ports...");
    let ports = run_raw("netstat", ["-an"]).await;
    if !ports.contains("[error:") {
        entries.push(#{
            "section": "ports",
            "command": "netstat",
            "args": ["-an"],
            "output": ports,
        });
    }

    sc::log("  filesystems...");
    push(entries, "filesystems", "mount", []).await;
    push(entries, "filesystems", "findmnt", []).await;
    push(entries, "filesystems", "lsblk", []).await;
    push(entries, "filesystems", "df", ["-h"]).await;
    push(entries, "filesystems", "df", ["-ih"]).await;
    push(entries, "filesystems", "du", ["-sh", "/var/log", "/tmp"]).await;
    push(entries, "filesystems", "du", ["-h", "/media/card"]).await;

    sc::log("  summary...");
    push(entries, "summary", "hostname", []).await;
    push(entries, "summary", "cat", ["/etc/os-release"]).await;
    push(entries, "summary", "uptime", []).await;
    push(entries, "summary", "systemctl", ["--failed", "--no-legend", "--no-pager"]).await;
    push(entries, "summary", "ip", ["-brief", "addr"]).await;
    push(entries, "summary", "uptime", []).await;
    push(entries, "summary", "free", ["-h"]).await;
    push(entries, "summary", "df", ["-h", "/"]).await;

    let payload = #{
        "format": "state-collector-json-v1",
        "generated_at": sc::timestamp(),
        "collector_version": sc::version(),
        "outdir": sc::outdir(),
        "entries": entries,
    };

    let json_text = json::to_string(payload)?;
    sc::write("state.json", json_text)?;

    sc::log("JSON collection complete.");
}
