// Collect system state and store it in a binary-encoded file.
// Usage:
//   state-collector examples/binary.rn

pub async fn collect() {
    sc::log(`starting binary collection at ${sc::timestamp()}`);
    sc::log("  collecting structured snapshot...");
    sc::write_bytes("state.bin", sc::to_postcard_bytes(sc::snapshot()?)?)?;
    sc::log("binary collection complete.");
}
